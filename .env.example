PORT=3000
# Optional on Render: RENDER_EXTERNAL_URL supplies the default origin automatically.
APP_ORIGIN=http://localhost:3000
# Leave empty for local SQLite. Required in production / on Render.
# For Neon use the pooled connection URL with TLS enabled.
DATABASE_URL=
# Google Cloud Console > Credentials > OAuth client (Web application).
# Authorized redirect URI: APP_ORIGIN + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Isolated, simulated bandmates. Disable when inviting your real band.
ALLOW_DEMO=true
# SQLite only, for local development:
# DB_PATH=/absolute/path/bandwagon.sqlite
